# Local Node development only: copy to .env (never commit it). All values are read in src/config.ts.
# In production (Cloudflare) the same names are wrangler.jsonc vars or `wrangler secret put` secrets.
PORT=8080
# Public HTTPS address of this server (used for the Discord redirect URI)
PUBLIC_URL=http://localhost:8080
# Address of the GitHub Pages site; also the only allowed browser origin
CLIENT_URL=http://localhost:5173
# At least 32 random characters, e.g. `node -e "console.log(crypto.randomBytes(32).toString('hex'))"`
SESSION_SECRET=
DB_PATH=./q-gala.db

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
# Optional: also require this role in the event server
DISCORD_REQUIRED_ROLE_ID=
DISCORD_INVITE_URL=https://discord.gg/your-invite

# Comma-separated lists
ADMIN_IDS=
TEST_ACCOUNT_IDS=
RESERVED_NAMES=

# Local development only: enables /auth/dev login without Discord. Never set in production.
DEV_LOGIN=1
